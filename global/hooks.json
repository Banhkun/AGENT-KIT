{
  "environment-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/safety-gate.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
